{
  "name": "injaz",
  "productName": "Injaz",
  "version": "1.0.0",
  "description": "إنجاز — تطبيق سطح مكتب لمتابعة المهام والإنتاجية والعادات",
  "main": "main.js",
  "author": "Osama Mohamed",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:portable": "electron-builder --win portable --x64 --publish never"
  },
  "build": {
    "appId": "com.osama.injaz",
    "productName": "Injaz",
    "copyright": "© 2026 Osama Mohamed",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "icon": "src/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Injaz-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Injaz-Portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  }
}
