{
  "name": "terramind-studio",
  "productName": "TerraMind Studio",
  "version": "1.2.0",
  "description": "Mining geology, resource estimation and mine design — desktop edition",
  "main": "desktop/main.js",
  "author": "TerraMind Studio",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/run-tests.js",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.terramind.studio",
    "productName": "TerraMind Studio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "vendor/**",
      "samples/**",
      "desktop/**",
      "README.md",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "tmd",
        "name": "TerraMind project",
        "description": "TerraMind Studio project"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "TerraMind Studio",
      "artifactName": "TerraMind-Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "TerraMind-Studio-Portable-${version}.${ext}"
    }
  }
}
